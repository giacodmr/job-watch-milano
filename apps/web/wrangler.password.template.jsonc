{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // NOT DEPLOYABLE: deliberately has no D1 IDs, owner, hostname or secrets.
  // This is an independent password runtime; the existing Access runtime stays unchanged.
  // For production, operator must create a private, gitignored deployment configuration.
  "name": "job-watch-password-unprovisioned",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "password"
  },
  "ratelimits": [
    {
      "name": "PASSWORD_RATE_LIMITER",
      "namespace_id": "873521",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
