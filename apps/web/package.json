{
  "name": "@job-watch/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply job-watch-local --local",
    "db:list:local": "wrangler d1 migrations list job-watch-local --local",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "worker:check": "wrangler deploy --dry-run --outdir .worker-build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
