# Phase 0: no credentials required. Vite must never receive server secrets.
# Copying this file is optional; defaults are in wrangler.jsonc.
APP_ENV=local
# Future server-only variables (leave unset until a separately authorized phase):
# ACCESS_TEAM_DOMAIN=
# ACCESS_AUDIENCE=
# GITHUB_REPOSITORY=giacodmr/job-watch-milano
# GitHub credentials and Access service secrets must use server secret storage.
# Never prefix secrets with VITE_. No OpenAI/LLM API credentials are used.
